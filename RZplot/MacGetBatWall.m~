  end

  if 1==0
  hf=figure(10*Mac.plot_BWP+4);
  Bna = real(exp(-i*Mac.n*Mac.phi)*Bt)';
  [pp,cc] = meshgrid(Mac.phi,Tw);
  pp = pp*180/pi;
