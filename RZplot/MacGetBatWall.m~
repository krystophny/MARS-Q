  xlabel('geometric toroidal angle','FontSize',16,'FontWeight','Bold')
  ylabel('geometric poloidal angle','FontSize',16,'FontWeight','Bold')

  %find poloidal angles for top,bottom,LFS,HFS
  [Y,k]=min(R(II,:)); chi_HFS=Mac.chi(k)*180/pi;
