   Btnew   = sqrt(abs(Brnew).^2 + abs(Bznew).^2 + abs(Bphinew).^2);
   Bnnew   = sqrt(abs(Brnew).^2 + abs(Bznew).^2);

   s2        = Mac.s(1:NN);
   [ss2,cc2] = meshgrid(s2,Mac.chi);
   Rnew2     = griddata(ss2,cc2,R(1:NN,1:N2)',ssn,ccn)';
   Znew2     = griddata(ss2,cc2,Z(1:NN,1:N2)',ssn,ccn)';
   Bparnew   = griddata(ss2,cc2,Bpar',ssn,ccn)';
   Bpernew   = sqrt(abs(Btnew.^2-abs(Bparnew).^2));

   hf = figure(Mac.plot_B_2D*10+0);
   pcolor(Rnew*Mac.R0EXP,Znew*Mac.R0EXP,log10(Btnew)), 
   %pcolor(Rnew*Mac.R0EXP,Znew*Mac.R0EXP,log10(abs(Bznew))), 
   res_dB_max = max(max(Btnew))
   colormap(jet),
   colorbar, hold on, shading interp
   %caxis([0 400])
   axis equal
   xlabel('R [m]','FontSize',16,'FontWeight','Bold')
   ylabel('Z [m]','FontSize',16,'FontWeight','Bold')
   title('log_{10}|{\delta}B| [G]','FontSize',14)
   %title('|{\delta}B| [G]','FontSize',14)
   ha=get(hf,'CurrentAxes'); set(ha,'FontSize',18)
   %axis([0 1.6 -1.05 1.05])
   if isstruct(Acad)
      if isfield(Acad,'axis'), axis(Acad.axis), end
   end

   if 1==1
   hf = figure(Mac.plot_B_2D*10+1);
   pcolor(Rnew*Mac.R0EXP,Znew*Mac.R0EXP,log10(Bpernew)), 
   colormap(jet),
   colorbar, hold on, shading interp
   %caxis([0 400])
   axis equal
   xlabel('R [m]','FontSize',16,'FontWeight','Bold')
   ylabel('Z [m]','FontSize',16,'FontWeight','Bold')
   title('log_{10}|{\delta}B|_{\perp} [a.u.]','FontSize',14)
   %title('|{\delta}B|_{\perp} [a.u.]','FontSize',14)
   ha=get(hf,'CurrentAxes'); set(ha,'FontSize',18)

   hf = figure(Mac.plot_B_2D*10+2);
   pcolor(Rnew*Mac.R0EXP,Znew*Mac.R0EXP,log10(abs(Bparnew))), 
   %pcolor(Rnew*Mac.R0EXP,Znew*Mac.R0EXP,real(Bparnew)), 
   colormap(jet),
   colorbar, hold on, shading interp
   %caxis([0 400])
   axis equal
   xlabel('R [m]','FontSize',16,'FontWeight','Bold')
   ylabel('Z [m]','FontSize',16,'FontWeight','Bold')
   title('log_{10}|{\delta}B_{||}| [a.u.]','FontSize',14)
   %title('{\delta}B_{||} [a.u.]','FontSize',14)
   ha=get(hf,'CurrentAxes'); set(ha,'FontSize',18)
   end
   
   %create 3D image based on Btnew
   if 1==0
      hf = figure(Mac.plot_B_2D*10+2);

      %cv = linspace(pi*0.55,pi*1.4,51);
      cv = linspace(0,pi*2,41);
      Rv = spline(cnew,Rnew(end,:),cv);
      Zv = spline(cnew,Znew(end,:),cv);
      aa = linspace(0,2*pi,101);
      ca = cos(aa);
      sa = sin(aa);
      Rn = Mac.R0EXP;
      Zn = Rn/3;
      for k=1:length(cv)-1
          C  = Rv(k)/Rn;
          Rt = C*Rn*ca;
          Zt = Zv(k) + C*Zn*sa;
          plot(Rt,Zt,'k-','LineWidth',0.5), hold on
      end
      
      pcolor(Rnew*Mac.R0EXP,Znew*Mac.R0EXP,Btnew), hold on
      pcolor(-Rnew*Mac.R0EXP,Znew*Mac.R0EXP,Btnew),
      colormap(jet),
      colorbar, hold on, shading interp
      axis equal
      axis off
      axis([-1.5 1.5 -1.3 1.2])
   end

   hf=figure(10*Mac.plot_B_2D+3);
   %plot(cnew*180/pi,Btnew(end,:),'r-','LineWidth',3), hold on 
   plot(cnew*180/pi,abs(Bznew(end,:)),'b-','LineWidth',3), hold on 
   %plot(cnew*180/pi,imag(Bznew(end,:)),'b:','LineWidth',3), hold on 
   xlabel('poloidal angle [deg.]','FontSize',18),
   %ylabel('|{\delta}B|_{edge} [Gauss]','FontSize',18),
   ylabel('{\delta}B_p|_{edge} [Gauss]','FontSize',18),
   ha=get(hf,'CurrentAxes'); set(ha,'FontSize',18)
   %a = axis; axis([0 360 a(3) a(4)])
   res_dBp_pls_surf = [real(Bznew(end,1)) imag(Bznew(end,1)) real(Bznew(end,81))  imag(Bznew(end,81))]

   if 1==0
   hf = figure(Mac.plot_B_2D*10+1);
   pcolor(Rnew*Mac.R0EXP,Znew*Mac.R0EXP,real(Brnew)*1e+4*Mac.B0EXP*2), 
   colorbar, hold on, shading interp
   axis equal
   xlabel('R [m]','FontSize',16,'FontWeight','Bold')
   ylabel('Z [m]','FontSize',14)
   title('Br [G]','FontSize',14)
   ha=get(hf,'CurrentAxes'); set(ha,'FontSize',12)

   hf = figure(Mac.plot_B_2D*10+2);
   pcolor(Rnew*Mac.R0EXP,Znew*Mac.R0EXP,real(Bznew)*1e+4*Mac.B0EXP*2), colorbar, hold on, shading interp
   axis equal
   xlabel('R [m]','FontSize',16,'FontWeight','Bold')
   ylabel('Z [m]','FontSize',14)
   title('Bz [G]','FontSize',14)
   ha=get(hf,'CurrentAxes'); set(ha,'FontSize',12)

   hf = figure(Mac.plot_B_2D*10+3);
   pcolor(Rnew*Mac.R0EXP,Znew*Mac.R0EXP,-real(Bphinew)*1e+4*Mac.B0EXP*2), colorbar, hold on, shading interp
   axis equal
   xlabel('R [m]','FontSize',16,'FontWeight','Bold')
   ylabel('Z [m]','FontSize',14)
   title('Bphi [G]','FontSize',14)
   ha=get(hf,'CurrentAxes'); set(ha,'FontSize',12)
   end
