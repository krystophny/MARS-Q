   ylabel('Im(\delta{B}_Z) [Gauss]','FontSize',16,'FontWeight','Bold')
   set(hs,'FontSize',14,'FontWeight','Bold')

   hf=figure(10*Mac.plot_BWR+2);

   Bc = Bz;

   plot(Tw,abs(Bc(II,JJ))*B0,'b-','LineWidth',3), hold on,
   ylabel('|{\delta}B_z| [Gauss]','FontSize',16,'FontWeight','Bold')
   ha=get(hf,'CurrentAxes'); set(ha,'FontSize',14,'FontWeight','Bold')
