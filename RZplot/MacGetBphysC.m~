   ylabel('Z [m]','FontSize',18,'FontWeight','Bold')
   %title('|\delta{B}| [Gauss]','FontSize',14)
   %title('|\delta{B}| [a.u.]','FontSize',14)
   title('|\delta{B}/B_0| (%)','FontSize',14)
   colorbar,  colormap(jet)
