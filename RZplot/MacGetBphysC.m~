function [Br,Bz,Bphi] = MacGetBphysC(R,Z,dRds1,dZds1,dRdchi1,dZdchi1,jacobian1,B1,B2,B3)
%% Get B-field components in Cylindrical coordinates

global Mac Acad
global SDIR FEEDI KFEED RIPPLE_MAX
global flux_mars

R0 = R;  Z0 = Z; 

% compute Br,Bz,Bphi at half-integer grid, then shift to integer grid
dRds=dRds1; dRds(1:end-1,:)=(dRds1(1:end-1,:)+dRds1(2:end,:))/2;
dZds=dZds1; dZds(1:end-1,:)=(dZds1(1:end-1,:)+dZds1(2:end,:))/2;
dRdchi=dRdchi1; dRdchi(1:end-1,:)=(dRdchi1(1:end-1,:)+dRdchi1(2:end,:))/2;
dZdchi=dZdchi1; dZdchi(1:end-1,:)=(dZdchi1(1:end-1,:)+dZdchi1(2:end,:))/2;
jacobian=jacobian1; jacobian(1:end-1,:)=(jacobian1(1:end-1,:)+jacobian1(2:end,:))/2;
R2=R; R2(1:end-1,:)=(R(1:end-1,:)+R(2:end,:))/2;
B11=B1; B11(1:end-1,:)=(B1(1:end-1,:)+B1(2:end,:))/2;

N  = size(B1,1);
Br = (B11.*dRds(1:N,:) + B2.*dRdchi(1:N,:))./jacobian(1:N,:); Br(1,:) = Br(2,:);
Bz = (B11.*dZds(1:N,:) + B2.*dZdchi(1:N,:))./jacobian(1:N,:); Bz(1,:) = Bz(2,:);
Bphi = B3.*R2(1:N,:)./jacobian(1:N,:);                Bphi(1,:) = Bphi(2,:);

Br(2:N,:)=Br(1:N-1,:);
Bz(2:N,:)=Bz(1:N-1,:);
Bphi(2:N,:)=Bphi(1:N-1,:);

NN   = Mac.Ns1-1;
G12 = dRds(1:NN,:).*dRdchi(1:NN,:) + dZds(1:NN,:).*dZdchi(1:NN,:);
G22 = dRdchi(1:NN,:).^2 + dZdchi(1:NN,:).^2;
DPSIEQ = (Mac.DPSIEQ(1:end-1)+Mac.DPSIEQ(2:end))/2*ones(1,size(B11,2));
TEQ    = (Mac.TEQ(1:end-1)+Mac.TEQ(2:end))/2*ones(1,size(B11,2));
BEQchi = DPSIEQ./jacobian(1:NN,:);
BEQ    = sqrt(BEQchi.^2.*G22 + TEQ.^2./R(1:NN,:).^2);
Bpar   = (G12(1:NN,:).*B11(1:NN,:)+G22(1:NN,:).*B2(1:NN,:)).*DPSIEQ./jacobian(1:NN,:).^2;
Bpar   = (Bpar + TEQ./jacobian(1:NN,:).*B3(1:NN,:))./BEQ;

%save (BR,BZ) date along  Mac.rw-surface
[smin,II] = min(abs(Mac.s-Mac.rw(1)));;
res = [R(II,:)*Mac.R0EXP; Z(II,:)*Mac.R0EXP; real(Br(II,:)); imag(Br(II,:)); real(Bz(II,:)); imag(Bz(II,:))];
res = res';
save b_ccoil.dat res -ascii -double

% plot (BR,BZ) along Mac.rw-surface
% along geometrical angle theta
if Mac.plot_BWR > 0
   [smin,II] = min(abs(Mac.s-Mac.rw(1)));
   Rw = R(II,:);
   Zw = Z(II,:);
   Tw = atan2(Zw-Z(1,1),Rw-R(1,1))*180/pi;
   [Tw,JJ]=sort(Tw);

   hf=figure(10*Mac.plot_BWR+0);
   plot(Rw*Mac.R0EXP,Zw*Mac.R0EXP,'b--x','LineWidth',1), hold on
   xlabel('R [m]','FontSize',16,'FontWeight','Bold')
   ylabel('Z [m]','FontSize',16,'FontWeight','Bold')
   axis equal
