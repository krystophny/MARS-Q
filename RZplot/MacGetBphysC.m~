   xlabel('\psi_p^{1/2}','FontSize',18,'FontWeight','Bold')
   ylabel('<|{\delta}B|> [kGauss]','FontSize',18,'FontWeight','Bold')
   %ylabel('<|{\delta}B/B_0|>','FontSize',18,'FontWeight','Bold')
   ha=get(hf,'CurrentAxes'); set(ha,'FontSize',18)

   %AmpB along outboard mid-plane
   hf=figure(10*Mac.plot_B + 5);
   JJ=round(Mac.Nchi/2)+1;
   plot(Mac.s(II),AmpB(II,JJ)/CN,'b-','LineWidth',3), hold on, 
   xlabel('\psi_p^{1/2}','FontSize',18,'FontWeight','Bold')
   %ylabel('|{\delta}B|(midplane) [Gauss]','FontSize',18,'FontWeight','Bold')
   ylabel('|{\delta}B/B_0|(midplane)','FontSize',18,'FontWeight','Bold')
   ha=get(hf,'CurrentAxes'); set(ha,'FontSize',18)

   if 1==1
      %surface average for CQL3D
      tmp = [Mac.s(II) mean(AmpB(II,:),2)];
      save CQL3D_data1.txt tmp -ascii
   end
end 

