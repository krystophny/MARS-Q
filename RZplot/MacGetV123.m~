   d = load([SDIR 'PROFEQ_n1']);
   x = d(:,1);
   y = d(:,10)/d(1,10);
   xx = linspace(0,1,2001);
   yy = spline(x,y,xx);
   dy = diff(yy)./diff(xx);
   xo = (xx(1:end-1)+xx(2:end))/2;
   dy = spline(xo,dy,x);
   for k=1:size(V1a,2)
       Vn(:,k) = V1a(:,k).*dy;
   end
end

