function [V1,V2,V3,Vn] = MacGetV123(VM1,VM2,VM3,VM1N,R,Z,dRds,dZds,dRdchi,dZdchi,jacobian)

global Mac SDIR Acad DISP_MAX

DPSIDS = Mac.DPSIEQ;
T      = Mac.TEQ;

expmchi = exp(Mac.Mm*Mac.chi*i);

% V1,2,3 along unit vectors a1,a2,a3
V1a = VM1*expmchi;
V2a = VM2*expmchi;
V3a = VM3*expmchi;
V1aN= VM1N*expmchi;

% V1 along e_s
chione = ones(1,Mac.Nchi);
ss = Mac.s(1:Mac.Ns1)*chione; ss(1,:) = ss(2,:);
%V1 = V1a.*jacobian(1:Mac.Ns1,:)./ss;  V1(1,:) = V1(2,:);
V1 = V1a;

% V2 along e_chi
Bchi = DPSIDS*chione./jacobian(1:Mac.Ns1,:);
Bphi = T*chione./R(1:Mac.Ns1,:).^2;
G11  = dRds(1:Mac.Ns1,:).^2 + dZds(1:Mac.Ns1,:).^2;
G12  = dRds(1:Mac.Ns1,:).*dRdchi(1:Mac.Ns1,:) + dZds(1:Mac.Ns1,:).*dZdchi(1:Mac.Ns1,:);
G22  = dRdchi(1:Mac.Ns1,:).^2 + dZdchi(1:Mac.Ns1,:).^2;
G22(1,:) = G22(2,:);
G33  = R(1:Mac.Ns1,:).^2;
B2   = Bchi.^2.*G22 + Bphi.^2.*G33;
V2 = -V1.*G12.*Bchi.^2./B2 + V2a.*Bphi.*G33./B2 + V3a.*Bchi;

% V3 along e_phi
V3 = -V1.*G12.*Bchi.*Bphi./B2 - V2a.*Bchi.*G22./B2 + V3a.*Bphi;

% Vn
GradS = sqrt(G33.*G22)./jacobian(1:Mac.Ns1,:);
Vn = V1a./GradS;
VnN= V1aN./GradS;

% V_poloidal
Vp = V2.*jacobian(1:Mac.Ns1,:)./sqrt(G33.*G11);
%Vp = dZdchi.*sqrt(G33.*G11)./jacobian(1:Mac.Ns1,:);
% Vn = Xi dot grad Ti = V1a*(dTi/ds) ==> ECEI data

