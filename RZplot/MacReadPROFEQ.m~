function MacReadPROFEQ(filename)

global Mac

if 1==0
Mac.R0EXP = 1;
Mac.B0EXP = 0.5238;
Mac.DEN   = 4.1144e+19;
Mac.TI    = 1.9274e+3;
Mac.TE    = 1.4419e+3;
Mac.Iratsurf = [];
Mac.plot_EQ=10;
end

SL          = Mac.SS;
Nclr        = 2;
kclr        = 1; 
kxp         = 1; %1:x=s; 2:x=psi_p
kscale      = 2; %1:MARS-F units; 2: SI units

LSC         = [(kclr-1)/(Nclr-1) (kclr-1)*(Nclr-kclr)*4/Nclr^2 (Nclr-kclr)/(Nclr-1)];

data = load(filename,'-ascii');
q    = data(:,2);
P    = data(:,4);
s    = data(:,1);  x=s;
Te   = data(:,11);
TEQ  = data(:,13);
DPSIEQ = data(:,12);

Mac.QEQ     = q;
Mac.TEQ    = TEQ;
Mac.DPSIEQ = DPSIEQ;
Mac.PEQ    = P;
Mac.omega  = data(:,6);
Mac.RESIST = data(:,7);

res = [s P];
save PROFP_EQ.txt res -ascii

s1   = (s(1:end-1)+s(2:end))/2;
dPds = diff(P)./diff(s);
dTds = diff(Te)./diff(s);
res = [s1.^2 dPds dTds];
save dPdTe.txt res -ascii

data(end-4:end,7) = data(end-5,7);  %resistivity

if size(data,2)>14
   data = [data data(:,6)-data(:,14)+data(:,15)];
end

%plot all profiles from PROFEQ
SY = {'s=\psi_N^{1/2}'
      'safety factor'
      'current density'
      'pressure'
      'density'
      'toroidal rotation'
      'resistivity=\tau_A/\tau_R=1/S'
      '\Gamma'
      'viscosity'
      'Ti'
      'Te'
      'd\psi/ds'
      'F'
      '\omega_{*i}'
      '\omega_{*e}'
      'CSV'
      'CSV'
      'electron rotation'};

if kxp==2
   x     = s.^kxp;
   SY{1} = '\psi_N';
end

FY = ones(length(SY),1);
if kscale==2
   TAUA  = Mac.R0EXP*sqrt(4e-7*pi*Mac.DEN*1.67261e-27*2)/Mac.B0EXP; %[s]
   FY(4) = Mac.B0EXP^2/(4e-7*pi)/1e+6; %[MPa]
   SY{4} = 'pressure [MPa]';
   FY(5) = Mac.DEN;  %[m^-3]
   SY{5} = 'density [1/m^3]';
   FY(6) = 1/TAUA/1000;   %[krad/s]
   SY{6} = 'toroidal rotation [krad/s]';
   FY(10) = Mac.TI/1000; %[keV]
   SY{10} = 'Ti [keV]';
   FY(11) = Mac.TE/1000; %[keV]
   SY{11} = 'Te [keV]';
   FY(18) = 1/TAUA;
   SY{18} = 'electron rotation [rad/s]';
end

kmask = zeros(length(SY),1);
kmask([2 4 5 6 10 11]) = 1;

% patch resistivity profile
y = data(:,7);
y(1:6) = y(7);
data(:,7) = y;

if Mac.plot_EQ>0
for k=2:length(SY)
    if kmask(k)==1
    y = data(:,k)*FY(k);  
    hf=figure(10*Mac.plot_EQ+k);
    plot(x,y,SL,'LineWidth',3), hold on,
    xlabel(SY(1),'FontSize',16,'FontWeight','Bold')
    ylabel(SY(k),'FontSize',16,'FontWeight','Bold')
    ha=get(hf,'CurrentAxes'); set(ha,'FontSize',16,'FontWeight','Bold')
    end
end
end

fignum = 10*Mac.plot_EQ+length(SY);

fignum = fignum + 1;
%plot mesh density
if 1==0
x  = data(:,1);
xo = (x(1:end-1)+x(2:end))/2;
hf=figure(fignum);
plot(xo.^2,diff(x),'r-+','LineWidth',1), hold on,
xlabel('\psi_p','FontSize',16,'FontWeight','Bold')
ylabel('mesh density','FontSize',16,'FontWeight','Bold')
ha=get(hf,'CurrentAxes'); set(ha,'FontSize',16)
end

fignum=fignum+1;
%plot ion/electron rotation
if 1==0
x  = data(:,1).^2;
hf=figure(fignum);
w = data(:,6);  
wi = data(:,14); wi(end)=wi(end-1);
we = data(:,15); we(end)=we(end-1);
plot(x,w,SL,'LineWidth',3), hold on,
plot(x,w-wi+we,'b--','LineWidth',3), hold on,
plot([0 1],[0 0],'k-'), hold on,
%sq=[1.0374e-02   1.2818e-01   5.3824e-01   6.5066e-01   7.1360e-01   7.5748e-01   7.9098e-01   8.1796e-01   8.4048e-01   8.5975e-01...
%    8.7656e-01   8.9142e-01   9.0467e-01   9.1657e-01   9.2731e-01   9.3699e-01   9.4574e-01   9.5363e-01   9.6076e-01   9.6717e-01...
%    9.7295e-01   9.7816e-01   9.8282e-01   9.8703e-01   9.9082e-01   9.9424e-01   9.9732e-01];
sq=[5.5344e-01   8.2097e-01   9.3528e-01   9.9030e-01];
a3=-0.06; a4=0.04;
plot([sq; sq],[a3*ones(size(sq)); a4*ones(size(sq))],'k--'), hold on,
axis([0 1 a3 a4])
xlabel('\psi_p','FontSize',16,'FontWeight','Bold')
ylabel('rotation frequency','FontSize',16,'FontWeight','Bold')
ha=get(hf,'CurrentAxes'); set(ha,'FontSize',16)
end

fignum=fignum+1;
%plot magnetic shear
if 1==0
x = data(:,1);
q = data(:,2);
w = data(:,6);
x0 = (x(1:end-1)+x(2:end))/2;
q0 = (q(1:end-1)+q(2:end))/2;
w0 = (w(1:end-1)+w(2:end))/2;
s  = x0./q0.*diff(q)./diff(x);
n  = 1;
mm = [1:6];
Is = mm;
for k=1:length(mm)
    [a,Is(k)] = min(abs(q0-mm(k)/n));
end
res = [mm(:) x0(Is).^2 s(Is) w0(Is)]
hf=figure(fignum);
plot(x0.^2,s,'-','LineWidth',2,'Color',LSC), hold on,
a = axis;
for k=1:length(mm)
    %plot([x0(Is(k)).^2 x0(Is(k)).^2],[a(3) a(4)],'k--'), hold on,
end
xlabel('\psi_p','FontSize',16,'FontWeight','Bold')
ylabel('magnetic shear','FontSize',16,'FontWeight','Bold')
ha=get(hf,'CurrentAxes'); set(ha,'FontSize',16)
end

%plot location of rational surfaces
if length(Mac.Iratsurf)>0 & 1==0
   hf=figure(10*Mac.plot_EQ+2);
   a=axis;
   for k=1:length(Mac.Iratsurf)
       l=Mac.Iratsurf(k);
       plot([Mac.s(l)^kxp Mac.s(l)^kxp],[a(3) a(4)],'k--'), hold on
   end
end

%find conversion between sqrt(psi_poloidal) and sqrt(psi_toroidal)
if 1==1
   sp = s;
   pp = sp.^2;
   y  = (q(1:end-1)+q(2:end))/2.*diff(pp);
   pt = [0; cumsum(y)];
   pt = pt/pt(end);
   st = sqrt(pt);
   res = [sp st];
   save MacPol2Tor.txt res -ascii
end
