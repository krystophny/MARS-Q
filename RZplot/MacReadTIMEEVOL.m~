% plot time evolution of the toroidal rotation profile
% from the output of MARS-Q runs with NCASE=6 (CALPHA7>0)
% Note that this is a stand-alone code,
% without coupling to other Mac* procedures

%kdev    = 25;  %D3D157376_n3-2, n=3:PROFEQ_00.OUT; n=2:PROFEQ_05.OUT
%kdev    = 45; %D3D157376_n6
%kdev    = 38; %AUG33353
%kdev    = 48; %ITER 7.5MA/5.3T_ISF
%kdev    = 55; %MAST-U45272
%kdev    = 56; %STEP_CASE1
%kdev    = 61; %STEP_CASE2
%kdev    = 62; %STEP_CASE3
%kdev    = 63; %STEP_CASE4
%kdev    = 66; %STEP_CASE5
