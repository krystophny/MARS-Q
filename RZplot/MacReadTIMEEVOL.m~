   if plotnp==6, tnew = linspace(t(1),t(end),Ntime); end
   if plotnp==7, tnew = linspace(t(end)-Tdel,t(end),Ntime); end
   NT   = length(tnew);
   y    = zeros(NT-2,length(s_new));
