kdev    = 69; %D3D163519.2650
%kdev    = 70; %D3D163520.1750
%kdev    = 71; %D3D163520.2650

Tmax = 1.126e+9; %maximal time to plot MARS-Q output
SCOL = 'b';

kplot = [
%no key fig  %comments
 1  1   1    %adaptive time step
 2  0   2    %time evolution of radial profile of rotation change DeltaOmega
 3  1   3    %time evolution of radial profile of total rotation Omega
 4  0   4    %time evolution of rotation at magnetic axis
 5  0   5    %time evolution of total rotation at rational surface(s)
 6  1   6    %time evolution of b1 field at rational surface(s)
 7  0   7    %time evolution of radial profile of surface-averaged jxb torque density
 8  0   8    %time evolution of radial profile of surface-averaged NTV torque density
 9  0   9    %time evolution of radial profile of surface-averaged Reynolds stress torque density
10  1  10    %time evolution of net torques
11  0  11    %time evolution of normal displacement amplitude along plasma surface
12  0  12    %net density pump-out
13  0  13    %time evolution of particle flux associated with MHD
14  0  14    %time evolution of particle flux associated with NTV
15  0  15    %time evolution of radial profile of density change
16  0  16    %time evolution of radial profile of total density 
17  1  6     %time evolution of sensor field at pickup locations
18  0  18    %compare particle fluxes from different terms at a given time
19  0  19    %time evolution of net particle flux across plasma boundary
20  0  20    %time evolution of volume-averaged plasma displacement
21  0  21    %analytic steady state solution: figs 21-23
22  0  30    %q-profile
23  1  31    %time evolution of rotation at q95 surface
];

MacReadParam

%mm = [1:1];
%n   = 1;

kprint = 0;
kname  = '_n1_01'; %file name extention when kprint=1 

%PLOT
%Case# n q95/TIMEEVOL_n_#/Tmax[ms]
%    2 1 9.95/04/70  9.9909/03/130 10.05/07/29.3
%    2 2 9.95/02/84  9.9909/01/100 10.05/03/14.4
%    3 1 11.1/03/70  11.283/02/120 11.4/06/19.7
%    3 2 11.1/04/100 11.283/02/32  11.4/06/31

Nmax = 50000;    %maximal time steps for plotting 
Tmin = 0.0e+04;
kres   = 0;       %1: plot rational surfaces
kscale = 1;
ks = 2;           %1: plot minor radius as s
                  %2: plot minor radius as psip=s.^2

plotnp = 5;       %select time slices for plotting
                  %0: plot all time slices
                  %1: plot end time step
                  %2: plot start and end time steps
                  %3: plot Ntime time slices
                  %4: plot time slices with physical time step of dtphys in [ms]
		  %5: plot the start and the last Ntime time slices
		  %6: plot time-averaged profiles at Ntime time slices, 
		  %   in [0,Tmax],with averaging window width of wtime
		  %7: plot time-averaged profiles at Ntime time slices, 
		  %   in [Tmax-Tdel,Tmax], with averaging window width of wtime
		  
Ntime  = 41;      %active when plotnp=3|5|6|7
wtime  = 1;     %active when plotnp=6|7
Tdel   = 65;       %active when plotnp=7

stime  = 1.3;     %minor radius for ploting time trace; use rational surface(s) if stime>1 
kedge  = 0;       %patch edge torque density
rleft  = 0;       %radial range [rleft,rright] for 2D plot (plot2d=2)
rright = 1;

SLEFT  = 0;     %SLEFT in MARS-Q runs

kplotsp = 2;      %1: time-stepping figure with one plot
                  %2: time-stepping figure with two subplots

plot2d = 1;       %0: do not plot 2D data
                  %1: 1D plot of profile evolution for rotation, density, etc.
                  %2: 2D plot of profile evolution for rotation, density, etc.

knew = 5;         %1: b1res + torque + rotation
                  %2: + xi_n
                  %3: + density pumpout
                  %4: + pickup signals
                  %5: + VDE displacement

if ks==1, SLAB = '\psi_p^{1/2}'; end
if ks==2, SLAB = '\psi_p'; end

% get re-normalisation factor
fac_td = 1.0;
fac_tt = 1.0;
fac_xn = 1.0;
fac_tm = 1.0;
fac_b1 = 1.0;
if kscale==1
   fac_td = B0^2/4e-7/pi;   %[N/m^2]
   fac_tt = fac_td*R0^3;    %[Nm]
   fac_xn = R0*1e+3;        %[mm]
   fac_tm = TAUA*1e+3;      %[ms]
   fac_b1 = B0*1e+4;        %[Gauss]
end

Tmax  = Tmax/fac_tm;
wtime = wtime/fac_tm;
Tdel  = Tdel/fac_tm;

%Axis2 = 0.528;   Tmax=Axis2/fac_tm;
Axis2 = -1.0;

% get the radial grid
data = load([SDIR 'PROFEQ.OUT']);
%data = load([SDIR 'PROFEQ_ROTneg']);
%data = load([SDIR 'PROFEQ_ROTpos']);
%data = load([SDIR 'PROFEQ_D3D157376_n3']);
%data = load([SDIR 'PROFEQ_MAST22264']);
%data = load([SDIR 'PROFEQ_MAST30128']);
%data = load([SDIR 'PROFEQ_MAST28912_n2']);
%data = load([SDIR 'PROFEQ_MAST29222_n2']);
%data = load([SDIR 'PROFEQ_MAST25056_n3']);
%data = load([SDIR 'PROFEQ_15MAQ10_n3']);

if SLEFT>0
   II = find(data(:,1)>SLEFT);
   data = data(II,:);
end

s1   = data(:,1);
w0   = data(:,6);  w0e = w0(end);
q1   = data(:,2);
d0   = data(:,5);
Te   = data(:,11);
s    = (s1(1:end-1)+s1(2:end))/2;  
w0   = (w0(1:end-1)+w0(2:end))/2;
d0   = (d0(1:end-1)+d0(2:end))/2;
% fine ISTIME
[Y,ISTIME] = min(abs(s1-stime));

% find rational surfaces
kplotq=0;
if kplot(22,2)==1, kplotq=kplot(22,3); end
[Is,rs,qs] = MacGetRatSurf(s1,q1,n,mm,kplotq,SCOL);  
NS = length(Is);
ms   = 1:NS;  

%Key figures: 15, 11, 9, 7, 6, 5, 3

% read the time evolution data from the MARS-Q output
filename  = 'TIMEEVOL.OUT'; Tstart=0; kc=1;
%filename  = 'TIMEEVOL_ESpotential'; Tstart=0; kc=1;
%filename  = 'TIMEEVOL_KRE'; Tstart=0; kc=1;
%filename  = 'TIMEEVOL_18_n4';  Tstart=7.4402e+04; kc=5; %Tstart=0; kc=1;
%filename   = 'TIMEEVOL_19_n2';  Tstart=0; kc=1;
%filename   = 'TIMEEVOL_19_n4';  Tstart=59920; kc=5;
%filename   = 'TIMEEVOL_19_n4_b';  Tstart=59920; kc=4;
%filename   = 'TIMEEVOL_37_n3';  Tstart=0; kc=1;
%filename   = 'TIMEEVOL_37_n2_b';  Tstart=1.043705147e+6; kc=3;
%filename   = 'TIMEEVOL_37_n2_lin2';  Tstart=0; kc=1;
%filename   = 'TIMEEVOL_03_n6';  Tstart=0; kc=5;
%filename  = 'TIMEEVOL_CHIM';
%filename = 'TIMEEVOL_MAST22264_24';
%filename = 'TIMEEVOL_MAST25056_13';
%filename = 'TIMEEVOL_14'; Tstart=0; kc=1;
%filename = 'Case02/TIMEEVOL.OUT';  Tstart=0; kc=1;
%filename = 'TIMEEVOL_MAST28912_02';
%filename = 'TIMEEVOL_14';  Tstart=0; kc=1;

data = load([SDIR filename],'-ascii');
%data = load('/cscratch/liuy/Data/ITER_MARSQ/TIMEEVOL_01h');
%data = load('/cscratch/liuy/WorkITERa/TIMEEVOL.OUT');
%data = load('~/IRIS/WorkD3Db/TIMEEVOL.OUT');

% de-densify large data
NDATA = size(data,1);
if NDATA>10000
   NDELTA = round(NDATA/10000);
   II     = 1:NDELTA:NDATA;
   NN = 1; if knew>3, NN=5; end
   tt = cumsum(data(:,NN)); tt = tt(II); tt = [tt(1); diff(tt)];
   data   = data(II,:);
   data(:,NN) = tt;
end
   
NN = 1;     %register of the array position
if knew>3
  NR              = data(1,1);
  NCHI           = data(1,2);
  NRATSURF = data(1,3);  NS = NRATSURF; 
  NPICK        = data(1,4);
  NN = 5;
end

delt = data(:,NN);  NN=NN+1; 

tt = cumsum(delt) + Tstart;
Tend = tt(end)
II = find(tt<Tmax & tt>Tmin);
if (tt(II(end))<tt(end)), II=[II; II(end)+1]; end
data = data(II,:); t=tt(II);
if length(II)>Nmax
   II=1:Nmax;
   data = data(II,:);
   t    = tt(II);
end   

%specify line color
Nc = 5;
SS = '-';
cc = zeros(Nc,3);
for k=1:Nc
    cc(k,1) = (k-1)/(Nc-1);
    cc(k,3) = (Nc-k)/(Nc-1);
    cc(k,2) = (k-1)*(Nc-k)/(Nc-1)^2;
end
cc = [0 0 1; 0 1 0; 1 0 0; 0 1 1; 0 0 0];

NR   = length(s);

dd = data(:,NN); NN=NN+1;         %net density pumpout (old model)
if knew==1, dd = data(:,NN); NN=NN+1; end        %net density pumpout (old model), imaginary part
if knew>1, ttrey = data(:,NN); NN=NN+1;  end    %net torque due to Reynolds stress tensor 
ttjxb = data(:,NN); NN=NN+1;      %net JXB torque
ttntv = data(:,NN); NN=NN+1;      %net NTV torque
b1pest = data(:,NN:NN+NS-1) + data(:,NN+2*NS:NN+3*NS-1)*i;                                  %resonant harmonic of b1 in PEST CS (even if MARS-F ran in EQUAC)
b1chi0 = data(:,NN+NS:NN+2*NS-1) + data(:,NN+3*NS:NN+4*NS-1)*i;  NN=NN+4*NS; %total b1 field at poloidal chi=0
dw = data(:,NN:NN+NR-1); NN=NN+NR;       %change of toroidal rotation radial profile
tjxb = data(:,NN:NN+NR-1); NN=NN+NR;      %JXB torque density radial profile
tntv = data(:,NN:NN+NR-1); NN=NN+NR;      %NTV torque density radial profile
if knew>1, trey = data(:,NN:NN+NR-1); NN=NN+NR;  end    %Reynolds stress torque density radial profile

if knew==2, NCHI = round((size(data,2)-NN+1)/2); end
if knew==3, NCHI = round((size(data,2)-NN+1-3*NR-2)/2); end

if knew>1
   Xn = data(:,NN:NN+NCHI-1) + data(:,NN+NCHI:NN+2*NCHI-1)*i;  NN=NN+2*NCHI;   %normal displacement of the plasma surface
end
if knew>2
   fdmhd = data(:,NN);  NN=NN+1;   %fraction of net density pump out due to the MHD (convective) particle flux
   fdntv   = data(:,NN);  NN=NN+1;   %fraction of net density pump out due to the NTV particle flux
   drho = data(:,NN:NN+NR-1); NN=NN+NR;   %change of density radial profile
   dmhd = data(:,NN:NN+NR-1); NN=NN+NR;   %MHD (convective) particle flux radial profile
   dntv = data(:,NN:NN+NR-1); NN=NN+NR;   %NTV particle flux radial profile
end
if knew>3 & NPICK>0
   bzpick = data(:,NN:NN+NPICK-1) + data(:,NN+NPICK:NN+2*NPICK-1)*i; NN=NN+2*NPICK;  %pick-up Bp signals
end

if knew>4
   xirz = data(:,NN:NN+3); NN = NN+4;  %VDE displacement 
end

if (NN-1) ~= size(data,2), disp('data array size error!'), end

%fix dw near magnetic axis
if 1==0
   I1 = find(s<0.05);
   dw(:,I1) = 0;
end

%scale amplitude of w0 to 1e-2 (only for STEP-P project)
if 1==0
   w0 = w0/w0(1)*1e-2;
end

%select time slices for plotting, default is all times
NP = length(t); IIT = [1:NP];
if plotnp==1
   IIT = [NP];
elseif plotnp==2
   IIT = [1 NP];
elseif plotnp==3
   tnew = linspace(t(1),t(end),Ntime);
   IIT   = ones(size(tnew));
   for k=1:length(tnew)
       [Y,I] = min(abs(t-tnew(k)));
       IIT(k) = I;
   end
elseif plotnp==4
   dtphys = 20;            %time interval in [ms] 
   tphys  = t*TAUA*1e+3;
   tnphys = dtphys:dtphys:tphys(end); 
   IIT    = ones(size(tnphys));
   for k=1:length(tnphys)
       [Y,I] = min(abs(tphys-tnphys(k)));
       IIT(k) = I;
   end
elseif plotnp==5
   IIT = [1 NP-Ntime+2:NP];
end

%====================================================================
%plot adaptive time step
%====================================================================
if kplot(1,2)==1
hf = figure(kplot(1,3));


if kplotsp==2, hs=subplot(2,1,1); end
%plot(tt*fac_tm,delt,SS,'Color',cc(kc,:),'LineWidth',3), hold on,
plot([1:length(tt)],delt,SS,'Color',cc(kc,:),'LineWidth',3), hold on,
if kscale==0
   %xlabel('t/\tau_A','FontSize',18)
   xlabel('iteration','FontSize',18)
else
   %xlabel('time [ms]','FontSize',18)
   xlabel('iteration','FontSize',18)
end
ylabel('\Delta t/\tau_A','FontSize',18)
if kplotsp==1, hs=get(hf,'CurrentAxes'); end
set(hs,'FontSize',16,'FontWeight','Bold')

if kplotsp==2
hs=subplot(2,1,2);
semilogy([1:length(tt)],tt,SS,'Color',cc(kc,:),'LineWidth',3), hold on,
xlabel('iteration','FontSize',18)
ylabel('t/\tau_A','FontSize',18)
