% conversion between EP energy in [MeV] and 
% the normalized particle moment p as defined in MARS-F REORBIT

format long e

% some constants
V_LIGHT = 2.99792E+8;
E_E     = 1.6021917E-19;
M_E     = 9.1095E-31;
M_I     = 1.67261E-27;

if 1==0
% for fusion born alphas
E = 3.5;  %in [MeV]
g = 1 + E_E*E*1e+6/(4*M_I*V_LIGHT^2); %=1.000932583576114e+00
p_alpha = sqrt(g.^2-1); %=4.319764882900128e-02
end

if 1==1
% for D-ions
E = linspace(4e-2,4e-2,1); %in [MeV]
g = 1 + E_E*E*1e+6/(2*M_I*V_LIGHT^2);
p = sqrt(g.^2-1);
end

if 1==0
% for REs
% E=1.86e-2MeV corresponds to the maximum-energy electrons produced by beta-decay of tritium nucleus
E = [1.86e-2 1 2 5 10 20 50 100]; %in [MeV]
g = 1 + E_E*E*1e+6/(M_E*V_LIGHT^2);
p = sqrt(g.^2-1);
end

res = [E(:) g(:) p(:)]
