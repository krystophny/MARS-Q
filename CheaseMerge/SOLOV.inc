C*COMDECK SOLOV
C ----------------------------------------------------------------------
C --     STATEMENT FUNCTION FOR SOLVEV PLASMA SECTION                 --
C --                         25.01.89            HL        CRPP       --
C --                                                                  --
C ----------------------------------------------------------------------
C --  SOLOVEV ANALYTICAL PSI = PSI(R,Z)                               --
C ----------------------------------------------------------------------
C
         SPS(R,Z) = SPSI0 * ((R * Z / ELONG)**2 + .25 *
     *                       (R**2 - RC**2)**2) / (ASPCT*RC)**2 
C
C ----------------------------------------------------------------------
C --  SOLOVEV ANALYTICAL DPSI / DR (R,Z)                              --
C ----------------------------------------------------------------------
C
         DSPSDR(R,Z) = SPSI0 * (2 * R * (Z / ELONG)**2 +
     *                          R * (R**2 - RC**2)) / (ASPCT * RC)**2
C
C ----------------------------------------------------------------------
C --  SOLOVEV ANALYTICAL DPSI / DZ (R,Z)                              --
C ----------------------------------------------------------------------
C
         DSPSDZ(R,Z) = 2 * SPSI0 * Z * (R / (RC * ASPCT * ELONG))**2
C
C ----------------------------------------------------------------------
C --  SOLOVEV ANALYTICAL D2PSI / DR2 (R,Z)                            --
C ----------------------------------------------------------------------
C
         D2SPSR(R,Z) = SPSI0 * (2 * (Z / ELONG)**2 +
     *                          3. * R**2 - RC**2) / (ASPCT * RC)**2
C
C ----------------------------------------------------------------------
C --  SOLOVEV ANALYTICAL D2PSI / DZ2 (R,Z)                            --
C ----------------------------------------------------------------------
C
         D2SPSZ(R,Z) = 2 * SPSI0 * (R / (RC * ASPCT * ELONG))**2
C
C ----------------------------------------------------------------------
C --  SOLOVEV ANALYTICAL D2PSI / (DR * DZ) (R,Z)                      --
C ----------------------------------------------------------------------
C
         DSPSRZ(R,Z) = 4 * SPSI0 * R * Z / (RC * ASPCT * ELONG)**2
C
