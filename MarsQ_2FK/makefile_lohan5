# Makefile for MARS-F on lohan4 - H. Reimerdes
# 04-21-2006 First try
#

# Macros
FFLAGS = -OPT:Olimit=0 -m64

PROG =	 marsf.x

SRCS =   dimensim.f globalm.f gijlm.f   \
         gijum.f feedbackm.f   gvacuumm.f  rcomdm.f \
         convolcofm.f  resmatm.f kineticm.f nag.f  pams.f   \
         marsf.f smlpck.f feedback.f printatoh.f \
         splines.f kinetic.f

INCS =	 cdipam.inc  newrun.inc   tent.inc vtophat.inc \
         tophat.inc  comioc.inc   integc.inc    \
         compam.inc  specmat.inc \
         vtent.inc   

MODS = 

.PRECIOUS:	$(SRCS) $(INCS) $(MODS)

OBJS =	$(SRCS:.f=.o)

#LIBDIR = \
#        -L/usr/pgi/linux86-64/6.1/lib

#LIBS = \
#        $(LIBDIR)
LIBS =

F95 = /usr/pgi/linux86-64/7.0-5/bin/pgf95
 
F95FLAGS = -O2 -r8 -tp amd64e
LDFLAGS =

all: $(PROG)

$(PROG): $(OBJS)
	$(F95) $(LDFLAGS) -o $@ $(OBJS) $(LIBS)

clean:
	rm -f $(PROG) $(OBJS) *.d work.*

test:
	echo $(OBJS) 

tar:
	gtar zcvf ../$(PROG).tar.gz $(SRCS) $(INCS) $(MODS) Makefile_Portland README

.SUFFIXES: $(SUFFIXES) .f

.f.o:
	$(F95) $(F95FLAGS) -c $<

